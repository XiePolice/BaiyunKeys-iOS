# 仓库内一律用 LF 存储。Windows 上的 core.autocrlf=true 会让工作区变成 CRLF，
# 而 macOS runner 检出时是 LF —— 显式声明可以避免两边不一致。
* text=auto eol=lf

# Xcode 工程文件，标成文本才能正常 diff / 合并
*.pbxproj    text eol=lf
*.xcscheme   text eol=lf
*.swift      text eol=lf
*.yml        text eol=lf
*.json       text eol=lf
*.md         text eol=lf

# 二进制，不要做任何换行转换
*.png        binary
*.jpg        binary
*.pdf        binary
*.ipa        binary
*.p12        binary
